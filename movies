        let watchlist = JSON.parse(localStorage.getItem('cine_watchlist')) || [1, 2];
        let currentSelectedMovieId = null;
        let heroMovieId = 1;
        let selectedGenre = 'Tất Cả';

        // Initialize application on load
        window.onload = function() {
            initHeroBanner();
            renderGrids();
            renderGenres();
            updateWatchlistUI();
        };

        // Tab Navigation Switcher
        function switchTab(tabName) {
            const tabs = ['home', 'catalog', 'watchlist'];
            tabs.forEach(t => {
                const viewEl = document.getElementById(`view-${t}`);
                const navEl = document.getElementById(`nav-${t}`);
                const mobNavEl = document.getElementById(`mob-nav-${t}`);

                if (t === tabName) {
                    viewEl.classList.remove('hidden');
                    if (navEl) {
                        navEl.classList.remove('text-gray-400', 'border-transparent');
                        navEl.classList.add('text-white', 'border-accentRed');
                    }
                    if (mobNavEl) {
                        mobNavEl.classList.remove('text-gray-400');
                        mobNavEl.classList.add('text-accentRed');
                    }
                } else {
                    viewEl.classList.add('hidden');
                    if (navEl) {
                        navEl.classList.remove('text-white', 'border-accentRed');
                        navEl.classList.add('text-gray-400', 'border-transparent');
                    }
                    if (mobNavEl) {
                        mobNavEl.classList.remove('text-accentRed');
                        mobNavEl.classList.add('text-gray-400');
                    }
                }
            });
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Initialize Hero Banner with movie #1 or random trending
        function initHeroBanner() {
            const movie = moviesData.find(m => m.id === heroMovieId) || moviesData[0];
            document.getElementById('hero-backdrop').style.backgroundImage = `url('${movie.backdrop}')`;
            document.getElementById('hero-genre').innerText = movie.genre;
            document.getElementById('hero-rating').innerText = movie.rating;
            document.getElementById('hero-year').innerText = movie.year;
            document.getElementById('hero-title').innerText = movie.title;
            document.getElementById('hero-desc').innerText = movie.desc;
            updateHeroWatchlistBtnState();
        }

        // Render Grids (Trending, Top Rated, Catalog, Watchlist)
        function renderGrids() {
            renderMovieGrid('trending-grid', moviesData.filter(m => m.trending));
            renderMovieGrid('toprated-grid', moviesData.filter(m => m.topRated));
            renderCatalogGrid(moviesData);
            renderWatchlistGrid();
        }

        // Helper to build movie card HTML
        function createMovieCard(movie) {
            const isSaved = watchlist.includes(movie.id);
            return `
                <div class="group relative bg-cardBg rounded-2xl overflow-hidden border border-gray-800/80 shadow-lg hover:shadow-2xl hover:border-accentRed/50 transition-all duration-300 flex flex-col justify-between">
                    <div class="relative aspect-[2/3] w-full overflow-hidden bg-gray-900 cursor-pointer" onclick="openMovieModal(${movie.id})">
                        <img src="${movie.poster}" alt="${movie.title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" onerror="this.src='https://placehold.co/400x600/131c2e/ffffff?text=CinePersonal'">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                            <span class="bg-accentRed text-white text-xs font-semibold px-3 py-1.5 rounded-lg flex items-center space-x-1 shadow-md">
                                <i class="fa-solid fa-play"></i> <span>Xem Ngay</span>
                            </span>
                        </div>
                        <div class="absolute top-3 left-3 bg-black/60 backdrop-blur-md text-yellow-400 text-xs font-bold px-2.5 py-1 rounded-lg flex items-center space-x-1 border border-white/10">
                            <i class="fa-solid fa-star"></i> <span>${movie.rating}</span>
                        </div>
                    </div>
                    <div class="p-4 flex flex-col justify-between flex-grow space-y-2">
                        <div>
                            <span class="text-[11px] text-accentRed font-semibold uppercase tracking-wider">${movie.genre}</span>
                            <h3 onclick="openMovieModal(${movie.id})" class="font-bold text-white text-sm sm:text-base line-clamp-1 cursor-pointer hover:text-accentRed transition">${movie.title}</h3>
                        </div>
                        <div class="flex items-center justify-between pt-2 border-t border-gray-800/60 text-xs text-gray-400">
                            <span>${movie.year}</span>
                            <button onclick="toggleWatchlist(${movie.id}, event)" class="w-8 h-8 rounded-full bg-gray-800/80 hover:bg-gray-700 flex items-center justify-center transition text-gray-300 hover:text-white" title="Thêm vào xem sau">
                                <i class="${isSaved ? 'fa-solid fa-bookmark text-accentRed' : 'fa-regular fa-bookmark'}"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }

        function renderMovieGrid(containerId, list) {
            const container = document.getElementById(containerId);
            if (!container) return;
            container.innerHTML = list.map(movie => createMovieCard(movie)).join('');
        }

        // Catalog Grid & Filters
        function renderGenres() {
            const genres = ['Tất Cả', ...new Set(moviesData.map(m => m.genre))];
            const container = document.getElementById('genre-filters');
            container.innerHTML = genres.map(g => `
                <button onclick="filterByGenre('${g}')" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition ${selectedGenre === g ? 'bg-accentRed text-white shadow-lg shadow-accentRed/30' : 'bg-gray-900 border border-gray-800 text-gray-400 hover:text-white hover:border-gray-700'}">
                    ${g}
                </button>
            `).join('');
        }

        function filterByGenre(genre) {
            selectedGenre = genre;
            renderGenres();
            filterCatalog();
        }

        function filterCatalog() {
            const query = document.getElementById('catalog-search').value.toLowerCase();
            let filtered = moviesData.filter(movie => {
                const matchesGenre = selectedGenre === 'Tất Cả' || movie.genre === selectedGenre;
                const matchesQuery = movie.title.toLowerCase().includes(query) || movie.director.toLowerCase().includes(query) || movie.cast.toLowerCase().includes(query);
                return matchesGenre && matchesQuery;
            });

            renderCatalogGrid(filtered);
        }

        function renderCatalogGrid(list) {
            const container = document.getElementById('catalog-grid');
            const emptyEl = document.getElementById('catalog-empty');
            if (list.length === 0) {
                container.innerHTML = '';
                emptyEl.classList.remove('hidden');
            } else {
                emptyEl.classList.add('hidden');
                container.innerHTML = list.map(movie => createMovieCard(movie)).join('');
            }
        }

        // Global search handler from top header
        function handleSearchInput(query) {
            if (query.trim().length > 0) {
                switchTab('catalog');
                document.getElementById('catalog-search').value = query;
                filterCatalog();
            }
        }

        // Watchlist Management
        function toggleWatchlist(movieId, event) {
            if (event) event.stopPropagation();
            const index = watchlist.indexOf(movieId);
            const movie = moviesData.find(m => m.id === movieId);

            if (index > -1) {
                watchlist.splice(index, 1);
                showToast(`Đã xóa "${movie.title}" khỏi danh sách xem sau.`);
            } else {
                watchlist.push(movieId);
                showToast(`Đã thêm "${movie.title}" vào danh sách xem sau!`);
            }

            localStorage.setItem('cine_watchlist', JSON.stringify(watchlist));
            updateWatchlistUI();
            renderGrids();
            if (currentSelectedMovieId === movieId) {
                updateModalWatchlistBtnState();
            }
        }

        function toggleWatchlistFromHero() {
            toggleWatchlist(heroMovieId);
            updateHeroWatchlistBtnState();
        }

        function toggleWatchlistFromModal() {
            if (currentSelectedMovieId !== null) {
                toggleWatchlist(currentSelectedMovieId);
                updateModalWatchlistBtnState();
            }
        }

        function updateWatchlistUI() {
            const count = watchlist.length;
            document.getElementById('watchlist-badge').innerText = count;
            document.getElementById('mob-watchlist-badge').innerText = count;
            renderWatchlistGrid();
        }

        function renderWatchlistGrid() {
            const container = document.getElementById('watchlist-grid');
            const emptyEl = document.getElementById('watchlist-empty');
            const savedMovies = moviesData.filter(m => watchlist.includes(m.id));

            if (savedMovies.length === 0) {
                container.innerHTML = '';
                emptyEl.classList.remove('hidden');
            } else {
                emptyEl.classList.add('hidden');
                container.innerHTML = savedMovies.map(movie => createMovieCard(movie)).join('');
            }
        }

        function updateHeroWatchlistBtnState() {
            const isSaved = watchlist.includes(heroMovieId);
            const icon = document.getElementById('hero-watchlist-icon');
            const text = document.getElementById('hero-watchlist-text');
            if (isSaved) {
                icon.className = 'fa-solid fa-bookmark text-accentRed';
                text.innerText = 'Đã Thêm Xem Sau';
            } else {
                icon.className = 'fa-regular fa-bookmark';
                text.innerText = 'Thêm Vào Xem Sau';
            }
        }

        function updateModalWatchlistBtnState() {
            const isSaved = watchlist.includes(currentSelectedMovieId);
            const icon = document.getElementById('modal-watchlist-icon');
            const text = document.getElementById('modal-watchlist-text');
            if (isSaved) {
                icon.className = 'fa-solid fa-bookmark text-accentRed';
                text.innerText = 'Đã Lưu Xem Sau';
            } else {
                icon.className = 'fa-regular fa-bookmark';
                text.innerText = 'Thêm Xem Sau';
            }
        }

        // Modal Controls & Trailer Simulation
        function openMovieModal(movieId) {
            currentSelectedMovieId = movieId;
            const movie = moviesData.find(m => m.id === movieId);
            if (!movie) return;

            document.getElementById('modal-backdrop').src = movie.backdrop;
            document.getElementById('modal-genre').innerText = movie.genre;
            document.getElementById('modal-rating').innerText = movie.rating;
            document.getElementById('modal-year').innerText = movie.year;
            document.getElementById('modal-duration').innerText = movie.duration;
            document.getElementById('modal-title').innerText = movie.title;
            document.getElementById('modal-desc').innerText = movie.desc;
            document.getElementById('modal-director').innerText = movie.director;
            document.getElementById('modal-cast').innerText = movie.cast;

            updateModalWatchlistBtnState();
            stopVideoMock();

            const modal = document.getElementById('movie-modal');
            const box = document.getElementById('modal-content-box');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                box.classList.remove('scale-95');
                box.classList.add('scale-100');
            }, 10);
        }

        function closeMovieModal() {
            const modal = document.getElementById('movie-modal');
            const box = document.getElementById('modal-content-box');
            stopVideoMock();
            modal.classList.add('opacity-0');
            box.classList.remove('scale-100');
            box.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

     

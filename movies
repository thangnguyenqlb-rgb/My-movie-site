<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phimcuathang - Trang Web Xem Phim & Nghe Nhạc Của Tôi</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkBg: '#0b0f19',
                        cardBg: '#131c2e',
                        accentRed: '#e50914',
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #0b0f19; }
        ::-webkit-scrollbar-thumb { background: #1f2937; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #374151; }
    </style>
</head>
<body class="bg-darkBg text-gray-100 min-h-screen flex flex-col justify-between selection:bg-accentRed selection:text-white">

    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-50 bg-darkBg/90 backdrop-blur-md border-b border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- Brand Logo -->
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('home')">
                <div class="bg-accentRed text-white p-2 rounded-xl shadow-lg shadow-accentRed/30 flex items-center justify-center">
                    <i class="fa-solid fa-film text-xl"></i>
                </div>
                <span class="text-xl font-bold tracking-wider bg-gradient-to-r from-white via-gray-200 to-gray-400 bg-clip-text text-transparent">
                    CinePersonal
                </span>
            </div>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center space-x-6 text-sm font-medium">
                <button onclick="switchTab('home')" id="nav-home" class="text-white transition hover:text-accentRed py-1 border-b-2 border-accentRed">Trang Chủ</button>
                <button onclick="switchTab('catalog')" id="nav-catalog" class="text-gray-400 transition hover:text-white py-1 border-b-2 border-transparent">Kho Phim</button>
                <button onclick="switchTab('music')" id="nav-music" class="text-gray-400 transition hover:text-white py-1 border-b-2 border-transparent flex items-center space-x-1.5">
                    <i class="fa-solid fa-music text-accentRed"></i><span>Góc Nhạc</span>
                </button>
                <button onclick="switchTab('watchlist')" id="nav-watchlist" class="text-gray-400 transition hover:text-white py-1 border-b-2 border-transparent flex items-center space-x-1.5">
                    <span>Xem Sau</span>
                    <span id="watchlist-badge" class="bg-accentRed text-white text-xs px-2 py-0.5 rounded-full font-bold">0</span>
                </button>
            </nav>

            <!-- Search & User Tools -->
            <div class="flex items-center space-x-4">
                <div class="relative hidden sm:block">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" id="global-search" placeholder="Tìm kiếm phim, diễn viên..." oninput="handleSearchInput(this.value)"
                        class="bg-gray-900/80 border border-gray-700 rounded-full pl-10 pr-4 py-1.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-accentRed w-48 lg:w-64 transition">
                </div>
                <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-accentRed to-orange-500 flex items-center justify-center font-bold text-sm shadow-md">
                    ME
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Subbar -->
        <div class="md:hidden flex justify-around bg-gray-900/90 border-t border-gray-800 py-2.5 text-xs font-medium">
            <button onclick="switchTab('home')" id="mob-nav-home" class="text-accentRed flex flex-col items-center space-y-1">
                <i class="fa-solid fa-house text-base"></i><span>Trang Chủ</span>
            </button>
            <button onclick="switchTab('catalog')" id="mob-nav-catalog" class="text-gray-400 flex flex-col items-center space-y-1">
                <i class="fa-solid fa-clapperboard text-base"></i><span>Kho Phim</span>
            </button>
            <button onclick="switchTab('music')" id="mob-nav-music" class="text-gray-400 flex flex-col items-center space-y-1">
                <i class="fa-solid fa-music text-base"></i><span>Nghe Nhạc</span>
            </button>
            <button onclick="switchTab('watchlist')" id="mob-nav-watchlist" class="text-gray-400 flex flex-col items-center space-y-1 relative">
                <i class="fa-regular fa-bookmark text-base"></i><span>Xem Sau</span>
                <span id="mob-watchlist-badge" class="absolute -top-1 right-2 bg-accentRed text-white text-[10px] px-1.5 rounded-full font-bold">0</span>
            </button>
        </div>
    </header>

    <!-- Main Dynamic Content Container -->
    <main class="flex-grow">

        <!-- TAB 1: HOME VIEW -->
        <div id="view-home" class="space-y-12 pb-16">
            <!-- Hero Banner Section -->
            <section class="relative h-[480px] sm:h-[540px] lg:h-[600px] w-full overflow-hidden">
                <div id="hero-backdrop" class="absolute inset-0 bg-cover bg-center transition-all duration-700 scale-105"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-darkBg via-darkBg/50 to-transparent"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-darkBg via-darkBg/60 to-transparent"></div>

                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col justify-end pb-12 relative z-10">
                    <div class="max-w-2xl space-y-4">
                        <div class="flex items-center space-x-3">
                            <span id="hero-genre" class="bg-accentRed/90 text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">Hành Động</span>
                            <span class="text-yellow-400 text-sm font-bold flex items-center space-x-1">
                                <i class="fa-solid fa-star"></i> <span id="hero-rating">8.9</span>
                            </span>
                            <span id="hero-year" class="text-gray-400 text-sm font-medium">2024</span>
                        </div>
                        <h1 id="hero-title" class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight">
                            Tựa Đề Phim Nổi Bật
                        </h1>
                        <p id="hero-desc" class="text-gray-300 text-sm sm:text-base line-clamp-3 leading-relaxed">
                            Mô tả chi tiết nội dung phim đặc sắc hấp dẫn sẽ hiển thị ở đây với nhiều tình tiết gay cấn và kỹ xảo đỉnh cao.
                        </p>
                        <div class="flex items-center space-x-4 pt-2">
                            <button id="hero-play-btn" onclick="openMovieModal(heroMovieId)" class="bg-accentRed hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-xl shadow-lg shadow-accentRed/30 flex items-center space-x-2 transition transform hover:scale-105">
                                <i class="fa-solid fa-play"></i>
                                <span>Xem Ngay / Trailer</span>
                            </button>
                            <button id="hero-watchlist-btn" onclick="toggleWatchlistFromHero()" class="bg-gray-800/80 hover:bg-gray-700 border border-gray-600 text-white font-semibold px-5 py-3 rounded-xl backdrop-blur-sm flex items-center space-x-2 transition">
                                <i class="fa-regular fa-bookmark" id="hero-watchlist-icon"></i>
                                <span id="hero-watchlist-text">Thêm Vào Xem Sau</span>
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Trending Section -->
            <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
                <div class="flex items-center justify-between">
                    <h2 class="text-2xl font-bold tracking-tight text-white flex items-center space-x-2.5">
                        <span class="w-2.5 h-7 bg-accentRed rounded-full inline-block"></span>
                        <span>Phim Thịnh Hành Hôm Nay</span>
                    </h2>
                    <button onclick="switchTab('catalog')" class="text-accentRed hover:text-red-400 text-sm font-semibold transition flex items-center space-x-1">
                        <span>Xem Tất Cả</span>
                        <i class="fa-solid fa-chevron-right text-xs"></i>
                    </button>
                </div>
                <div id="trending-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-6"></div>
            </section>

            <!-- Top Rated Section -->
            <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
                <div class="flex items-center justify-between">
                    <h2 class="text-2xl font-bold tracking-tight text-white flex items-center space-x-2.5">
                        <span class="w-2.5 h-7 bg-yellow-500 rounded-full inline-block"></span>
                        <span>Được Đánh Giá Cao Nhất</span>
                    </h2>
                </div>
                <div id="toprated-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-6"></div>
            </section>
        </div>

        <!-- TAB 2: CATALOG / FULL MOVIES VIEW -->
        <div id="view-catalog" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-800 pb-6">
                <div>
                    <h1 class="text-3xl font-extrabold text-white">Kho Phim Đầy Đủ</h1>
                    <p class="text-sm text-gray-400 mt-1">Khám phá toàn bộ danh mục phim đặc sắc được cập nhật liên tục.</p>
                </div>
                <div class="relative w-full md:w-80">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" id="catalog-search" placeholder="Tìm theo tên phim, đạo diễn..." oninput="filterCatalog()"
                        class="bg-gray-900 border border-gray-700 rounded-xl pl-10 pr-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-accentRed w-full transition">
                </div>
            </div>
            <div id="genre-filters" class="flex flex-wrap gap-2"></div>
            <div id="catalog-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-6 pt-2"></div>
            <div id="catalog-empty" class="hidden text-center py-20 space-y-4">
                <div class="text-5xl text-gray-600"><i class="fa-solid fa-film-slash"></i></div>
                <h3 class="text-xl font-bold text-gray-300">Không tìm thấy phim phù hợp</h3>
            </div>
        </div>

        <!-- TAB 3: MUSIC PLAYER VIEW (GÓC NHẠC) -->
        <div id="view-music" class="hidden max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
            <div class="border-b border-gray-800 pb-6 flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-extrabold text-white flex items-center space-x-3">
                        <i class="fa-solid fa-headphones text-accentRed"></i>
                        <span>Góc Nhạc Thư Giãn Của Thăng</span>
                    </h1>
                    <p class="text-sm text-gray-400 mt-1">Thưởng thức những bản nhạc Lofi, Acoustic và Guitar yêu thích ngay trên trang web.</p>
                </div>
            </div>

            <!-- Main Active Player Card -->
            <div class="bg-cardBg border border-gray-800 rounded-2xl p-6 sm:p-8 shadow-2xl grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
                <div class="relative aspect-square rounded-xl overflow-hidden bg-gray-900 shadow-lg group">
                    <img id="current-song-cover" src="https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?q=80&w=600&auto=format&fit=crop" alt="Song cover" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                    <div class="absolute inset-0 bg-black/30 flex items-center justify-center">
                        <div class="w-14 h-14 bg-accentRed/90 rounded-full flex items-center justify-center text-white text
